MYSQL_DATABASE=frameforge
MYSQL_USER=frameforge
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
DATABASE_URL=mysql+pymysql://frameforge:change-me@mysql:3306/frameforge
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:29000
MINIO_ACCESS_KEY=frameforge
MINIO_SECRET_KEY=change-minio-secret
MINIO_BUCKET=frameforge-assets
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:28080
PROVIDER_MODE=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_IMAGE_MODEL=wan2.6-t2i
DASHSCOPE_IMAGE_SIZE=1280*1280
DASHSCOPE_VIDEO_MODEL=wan2.6-i2v-flash
DASHSCOPE_TTS_MODEL=qwen3-tts-flash
DASHSCOPE_CHAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
EMBEDDING_MODE=fake
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DIRECTOR_LLM_MODE=fake
DASHSCOPE_LLM_MODEL=qwen-plus
COMFYUI_URL=http://comfyui:8188
COMFYUI_CHECKPOINT=
COMFYUI_MODELS_PATH=./.local/comfyui-models/checkpoints
PROVIDER_CALLBACK_SECRET=
PROVIDER_CALLBACK_MAX_SKEW_SECONDS=300
